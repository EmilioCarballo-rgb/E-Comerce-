<main class="category-main">

    <div class="category-back-container">
        <a href="/" class="btn-back-home">Volver al inicio</a>
    </div>

    <div class="category-header">
        <h1 class="category-title">
            Categoría: <%= categoryName %>
        </h1>
    </div>

    <% if (products.length> 0) { %>

        <div class="category-controls">
            <span class="category-sort-label">Ordenar por precio:</span>

            <a href="?sort=asc" class="btn-sort btn-sort-asc">Menor a Mayor ⬆️</a>
            <a href="?sort=desc" class="btn-sort btn-sort-desc">Mayor a Menor ⬇️</a>
        </div>

        <div class="category-grid">
            <% products.forEach(producto=> { %>
                <%- include('../partials/productCard', { product: producto }) %>
                    <% }) %>
        </div>

        <% } else { %>
            <div class="category-empty">
                <h2 class="category-empty-title">¡Uy! Todavía no hay productos acá.</h2>
                <p class="category-empty-text">
                    Estamos preparando nuevos ingresos para la categoría <strong>
                        <%= categoryName %>
                    </strong>. ¡Volvé pronto!
                </p>
                <a href="/" class="btn-empty-return">
                    Ver todos los productos
                </a>
            </div>
            <% } %>

</main>