<main class="category-main" style="padding: 40px 5%;">
    <div class="category-header" style="text-align: center; margin-bottom: 30px;">
        <h2 class="category-title" style="text-transform: capitalize; font-size: 2.5rem; color: #333;">
            Categoría: <%= categoryName %>
        </h2>
    </div>

    <% if (products && products.length > 0) { %>
        <div class="product-grid">
            <% products.forEach(product => { %>
                <!-- Asegúrate de que la ruta a tu partial de productCard sea correcta -->
                <%- include('../partials/productCard', { product: product }) %>
            <% }) %>
        </div>
    <% } else { %>
        <div style="text-align: center; padding: 40px;">
            <p style="font-size: 1.2rem; color: #666;">No hay productos disponibles en esta categoría por el momento.</p>
            <a href="/" class="btn-empty-return" style="background-color: #4a4e54; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Volver al inicio</a>
        </div>
    <% } %>
</main>